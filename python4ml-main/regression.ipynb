   "source": [
    "### Excercise 1\n",
    "\n",
    "Please, implement the function *mse* below to compute the MSE between the original values and the predicted values and compare it's result to the *metrics.mean_squared_error*\n",
    "$$\n",
    "MSE = \\frac{1}{n} \\sum_{i=1}^n{(y-\\widehat{y})^2}\n",
    "$$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "collapsed": false,
    "jupyter": {
     "outputs_hidden": false
    },
    "pycharm": {
     "name": "#%%\n"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0.41555451352034783\n",
      "0.4155545135203479\n",
      "-5.551115123125783e-17\n"
     ]
    }
   ],
   "source": [
    "\n",
    "def mse(y_true, y_pred):\n",
    "    n = len(y_true)\n",
    "    mse_value = sum((y_true - y_pred) ** 2) / n\n",
    "    return mse_value\n",
    "\n",
    "print(metrics.mean_squared_error(y, y_pred))\n",
    "print( mse(y, y_pred))\n",
    "\n",
    "print(metrics.mean_squared_error(y, y_pred) - mse(y, y_pred))"
   ]
  },
